<style>
  iframe {
      width: 100%;
      border: none; /* Disable border */
      outline: none !important; /* Disable focus outline */
      box-shadow: none !important; /* Disable shadow */
      overflow: hidden; /* Ensure no scrollbars */
      height: 160vh;
  }
</style>

<iframe id="dynamic-iframe" frameborder="0" scrolling="no"></iframe>

<script>
  // Function to fetch the iframe source and set it dynamically
  async function setIframeSrc() {
      try {
          // Assuming Shopify.shop is a variable available in the JS context
          const shopVariable = Shopify.shop;
          const response = await fetch(`https://phpstack-953879-3439374.cloudwaysapps.com/api/${shopVariable}/get-src`);
          if (!response.ok) {
              throw new Error(`HTTP error! Status: ${response.status}`);
          }

          const data = await response.json(); // Assuming the response is a plain text URL
          console.log(data)
          const iframe = document.getElementById('dynamic-iframe');

          if (iframe && data) {
              iframe.src = 'https://phpstack-953879-3439374.cloudwaysapps.com/s/' + data.data;
          } else {
              console.error('Failed to set iframe source: Invalid data or element not found');
          }
      } catch (error) {
          console.error('Error fetching iframe source:', error);
      }
  }

  // Call the function to set the iframe source
  setIframeSrc();
</script>

{% schema %}
{
  "name": "Landing Page",
  "target": "section"
}
{% endschema %}
